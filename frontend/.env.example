# Indirizzo del backend, se non gira su localhost:8000
# VITE_BACKEND_HTTP=http://localhost:8000
# VITE_BACKEND_WS=ws://localhost:8000/ws

# Feed del render da TouchDesigner (Web Server DAT).
# Con VITE_TD_FEED_WS impostato si usa il WebSocket: TouchDesigner spinge i
# fotogrammi al proprio ritmo e sparisce il round-trip HTTP. Lasciandolo vuoto
# si ripiega sul polling HTTP di VITE_TD_FEED, che resta utile per diagnosi:
# quell'indirizzo si apre in un browser qualsiasi.
VITE_TD_FEED=http://localhost:9980
VITE_TD_FEED_WS=ws://localhost:9980

# Fotogrammi al secondo, solo per il polling. Col WebSocket il ritmo lo decide
# TouchDesigner (TARGET_FPS in touchdesigner/feed_push_frames.py).
VITE_TD_FEED_FPS=25

# Segnalazione WebRTC: il pannello riceve il render direttamente da
# TouchDesigner, con la codifica fatta sulla GPU. Il backend fa solo da
# centralino per la stretta di mano iniziale.
# Lasciandolo vuoto si torna alle due strade JPEG qui sotto.
VITE_TD_SIGNAL=ws://localhost:8000/ws/signal/panel
